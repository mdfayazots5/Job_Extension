{
  "manifest_version": 3,
  "name": "Job Extensions",
  "version": "0.5.0",
  "description": "Collects job listings from your own LinkedIn, Naukri and Indeed searches into one local, sortable list. Includes a guided tour and sample data.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://in.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Extensions",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/sites/naukri/api-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/sites/naukri/api-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "config.js",
        "src/core/storage.js",
        "src/core/text-match.js",
        "src/sites/linkedin/selectors.js",
        "src/sites/linkedin/metadata.js",
        "src/sites/linkedin/adapter.js",
        "src/sites/registry.js",
        "src/core/run-loop.js",
        "src/sites/linkedin/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/core/storage.js",
        "src/core/text-match.js",
        "src/sites/naukri/config.js",
        "src/sites/naukri/selectors.js",
        "src/sites/naukri/adapter.js",
        "src/core/run-loop.js",
        "src/sites/naukri/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://in.indeed.com/*",
        "https://in.indeed.com/jobs*",
        "https://in.indeed.com/q-*"
      ],
      "js": [
        "src/core/storage.js",
        "src/core/text-match.js",
        "src/sites/indeed/config.js",
        "src/sites/indeed/selectors.js",
        "src/sites/indeed/parse.js",
        "src/sites/indeed/adapter.js",
        "src/sites/registry.js",
        "src/core/run-loop.js",
        "src/sites/indeed/collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
