{
  "manifest_version": 3,
  "name": "Job Extensions",
  "version": "0.4.0",
  "description": "A local-only LinkedIn, Naukri, and Indeed jobs collector with a live results page.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://in.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Extensions",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/sites/naukri/api-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/sites/naukri/api-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "config.js",
        "src/core/storage.js",
        "src/sites/linkedin/selectors.js",
        "src/sites/linkedin/metadata.js",
        "src/sites/linkedin/adapter.js",
        "src/sites/registry.js",
        "src/core/run-loop.js",
        "src/sites/linkedin/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/core/storage.js",
        "src/sites/naukri/config.js",
        "src/sites/naukri/selectors.js",
        "src/sites/naukri/adapter.js",
        "src/core/run-loop.js",
        "src/sites/naukri/collector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://in.indeed.com/*"
      ],
      "js": [
        "src/core/storage.js",
        "src/sites/indeed/config.js",
        "src/sites/indeed/selectors.js",
        "src/sites/indeed/parse.js",
        "src/sites/indeed/adapter.js",
        "src/sites/registry.js",
        "src/core/run-loop.js",
        "src/sites/indeed/collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
